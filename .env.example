GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Optional: FastAPI backend URL (frontend falls back to direct calls if unset)
BACKEND_URL=http://127.0.0.1:8000

# Optional: WAQI Air Quality API token (uses "demo" if unset)
WAQI_TOKEN=demo

# Optional: Redis connection URL for response caching
# REDIS_URL=redis://localhost:6379

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
